{
  "name": "refinedrobin",
  "version": "1.0.0",
  "description": "Chrome extension for automated form filling on claude.ai",
  "main": "dist/background.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "24.8.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "jsdom": "27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "chrome-extension",
    "automation",
    "claude-ai"
  ],
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  },
  "author": "",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
